# Copy to .env; set a private local database password before starting Compose.
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/wingman
DATABASE_USERNAME=wingman
ELASTICSEARCH_URL=http://localhost:9200
PUBLIC_APP_URL=http://localhost:3000
APP_VERSION=local

# Supply privately. OpenAI-compatible providers; no browser-exposed credentials.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
OTEL_SERVICE_NAME=conference-wingman-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
